void main
(
	float4 color0 : COLOR0,
	float4 position : TEXCOORD0,
	float2 texcoord : TEXCOORD1,
	
	uniform float mode,
	uniform sampler2D texture,
	
	out float4 oColor
)
{
	float4 color = tex2D(texture,texcoord);
	float4 modtex = tex2D(texture,texcoord) * color0;

	// Default: DECAL (tex * alpha + shade * (1-alpha))
	oColor.r = color.r * color.a + color0.r * (1.0 - color.a);
	oColor.g = color.g * color.a + color0.g * (1.0 - color.a);
	oColor.b = color.b * color.a + color0.b * (1.0 - color.a);
	oColor.a = 1.0;

	// SHADER_PASSTEX: texture only
	if(mode==1) oColor.r = color.r;
	if(mode==1) oColor.g = color.g;
	if(mode==1) oColor.b = color.b;
	if(mode==1) oColor.a = color.a;

	// SHADER_PASSCOLOR: vertex color only
	if(mode==2) oColor.r = color0.r;
	if(mode==2) oColor.g = color0.g;
	if(mode==2) oColor.b = color0.b;
	if(mode==2) oColor.a = color0.a;

	// SHADER_MODULATE: texture * vertex color
	if(mode==3) oColor.r = modtex.r;
	if(mode==3) oColor.g = modtex.g;
	if(mode==3) oColor.b = modtex.b;
	if(mode==3) oColor.a = modtex.a;
}
