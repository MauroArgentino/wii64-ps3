void main
(
	float4 color0 : COLOR0,
	float4 position : TEXCOORD0,
	float2 texcoord : TEXCOORD1,
	
	uniform float mode,
	uniform sampler2D texture,
	
	out float4 oColor
)
{
	float4 color = tex2D(texture,texcoord);
	
	if(mode==1) //SHADER_PASSTEX
		oColor = color;
	if(mode==2) //SHADER_PASSCOLOR
		oColor = color0;
	if(mode==3) //SHADER_MODULATE
		oColor = tex2D(texture,texcoord) * color0;
	if(mode==4) //SHADER_DECAL
	{
		float a = color.a;
		oColor.r = color.r * a + color0.r * (1.0 - a);
		oColor.g = color.g * a + color0.g * (1.0 - a);
		oColor.b = color.b * a + color0.b * (1.0 - a);
		oColor.a = a;
	}
}
