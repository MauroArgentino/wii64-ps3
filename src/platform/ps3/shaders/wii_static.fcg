void main
(
	float4 color0 : COLOR0,
	float4 position : TEXCOORD0,
	float2 texcoord : TEXCOORD1,

	uniform float time,

	out float4 oColor
)
{
	// position.xy = screen-space pixel coords (0..640, 0..480)
	float2 p = position.xy;

	// Animate: shift seed every ~12 fps for flickering TV static
	float seed = floor(time * 12.0);

	// --- SIN-FREE HASH (Dave Hoskins method) ---
	// Produces well-distributed pseudo-random per-pixel values
	float2 q = p + float2(seed * 17.31, seed * 43.17);
	float3 p3 = frac(float3(q.xyx) * float3(0.1031, 0.1030, 0.0973));
	p3 += dot(p3, p3.yzx + 33.33);
	float noise = frac((p3.x + p3.y) * p3.z);

	// Boost contrast: push toward black or white for crisp static
	float grain = (noise < 0.5) ? noise * 0.5 : noise * 1.8;
	grain = clamp(grain, 0.0, 1.0);

	// Subtle vertical scanline pattern (CRT phosphor lines)
	float scanline = 0.88 + 0.12 * step(0.5, frac(p.y * 0.5));

	oColor = float4(grain * scanline, grain * scanline, grain * scanline, color0.a);
}
